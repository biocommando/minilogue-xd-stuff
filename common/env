PROJ_BASE_PATH=$(readlink -f "$(dirname "${BASH_SOURCE[-1]}")/..")
TOOLS_DIR=$PROJ_BASE_PATH/common/scripts/
MANIFEST_TOOL=$TOOLS_DIR/manifest_tool.py

function uuresolve {
    if [ "$1" == "" ]
    then
        touch /tmp/.minilogue-xd-stuff.uuresolve
        cat /tmp/.minilogue-xd-stuff.uuresolve
        return 0
    fi
    resolved=$(echo $1 | grep -o "[a-zA-Z0-9-]*")
    echo $resolved > /tmp/.minilogue-xd-stuff.uuresolve
    echo $resolved
}

function uulist {
    find "$PROJ_BASE_PATH"/ -maxdepth 1 -type d -regex ".*/[a-z][^/]*" | grep -Ev ".*/(release.*|common)$" | grep -o "[a-z0-9-]*$"
}

function uumake {
    proj=$(uuresolve "$1")
    cd "$PROJ_BASE_PATH/$proj"
    make clean
    make PRE_ALL
    if [ "$?" != "0" ]
    then
      echo "<<$proj>> Make PRE_ALL failed"
      cd -
      return 1
    fi
    $MANIFEST_TOOL --verify manifest.json --generate-params-header manifest_params.h
    if [ "$?" != "0" ]
    then
      echo "<<$proj>> Manifest JSON invalid"
      cd -
      return 1
    fi
    make
    if [ "$?" != "0" ]
    then
      echo "<<$proj>> Make failed"
      cd -
      return 1
    fi
    make install
    cd -
}

function get_proj_manifest_field {
    $MANIFEST_TOOL "$PROJ_BASE_PATH/$1/manifest.json" --get $2
}

function get_proj_manifest_name {
    get_proj_manifest_field "$1" name
}

function uudeploy {
    proj=$(uuresolve "$1")
    name=$(get_proj_manifest_name $proj)
    path="$PROJ_BASE_PATH/$proj/$name.mnlgxdunit"
    cp "$path" "$MINILOGUE_STUFF_DEPLOY_DIR"
    echo copied $path to "$MINILOGUE_STUFF_DEPLOY_DIR"
}

function uurelease_one {
    p=$1
    onedest=$2
    echo "+++++++++++++ Building $p +++++++++++++"
    uumake $p
    if [ "$?" != "0" ]
    then
      echo "<<$p>> Build failed"
      return 1
    fi
    $MANIFEST_TOOL "$PROJ_BASE_PATH/$p/manifest.json" --get version --update-with $version >/dev/null
    if [ "$?" != "0" ]
    then
      echo "<<$p>> Setting version failed"
      return 1
    fi
    name=$(get_proj_manifest_name $p)
    path="$PROJ_BASE_PATH/$p/$name.mnlgxdunit"

    module=$(get_proj_manifest_field $p module)
    mkdir -p "$onedest"/$module/doc

    cp "$path" "$onedest"/$module
    if [ "$?" != "0" ]
    then
      echo "<<$p>> Copying binary failed"
      return 1
    fi
    cp "$PROJ_BASE_PATH/$p/README.md" $onedest/$module/doc/README_$name.md
    if [ "$?" != "0" ]
    then
      echo "<<$p>> Copying readme failed"
      return 1
    fi
    python3 $TOOLS_DIR/gen_html_cheat_sheet.py "$PROJ_BASE_PATH/$p/README.md" > $onedest/$module/doc/cheat_sheet_$name.html
    echo "- $name" >> $onedest/README.md
    echo "    - type: $module" >> $onedest/README.md
    echo "    - description: $(head -n 1 "$PROJ_BASE_PATH/$p/README.md")" >> $onedest/README.md
}

function uurelease {
    version=$1
    dest=$PROJ_BASE_PATH/release-$version
    rm -rf "$dest" "$dest.zip"
    mkdir -p "$dest"
    mkdir -p "$dest/experimental"
    echo "# A Collection of Korg Minilogue XD User Modules" > $dest/README.md
    echo "List of modules:" >> $dest/README.md
    for p in $(uulist | sort)
    do
        experimental=$($TOOLS_DIR/project_tool.py is_experimental "$PROJ_BASE_PATH/$p")
        variants=$($TOOLS_DIR/project_tool.py variants "$PROJ_BASE_PATH/$p" | tac)
        if [ "$variants" == "" ]; then
            uurelease_one $p "$dest/$experimental" $version
            if [ "$?" != "0" ]
            then
              echo "<<$p>> Release failed"
              return 1
            fi
        else
            for variant in $variants
            do
                cd "$PROJ_BASE_PATH/$p"
                make prepare VARIANT=$variant
                if [ "$?" != "0" ]
                then
                  echo "<<$p>> Variant prepare failed for $variant"
                  cd -
                  return 1
                fi
                cd -
                uurelease_one $p "$dest/$experimental" $version
                if [ "$?" != "0" ]
                then
                  echo "<<$p>> Release failed for variant $variant"
                  return 1
                fi
            done
        fi
    done
    echo "# License" >> $dest/README.md
    echo "### Module code" >> $dest/README.md
    cat $PROJ_BASE_PATH/LICENSE.md >> $dest/README.md
    echo "----" >> $dest/README.md
    echo "### Logue SDK" >> $dest/README.md
    cat $PROJ_BASE_PATH/../../../LICENSE >> $dest/README.md
    echo "Created release-$version directory succesfully, creating zip package"
    zip -jr "$dest.zip" "$dest"
}

function uuhelp {
    echo "Available functions:"
    echo "  uuhelp -- Print this message"
    echo "  uulist -- lists all projects"
    echo "  uumake <proj> -- runs make, checks manifest.json"
    echo "                   and runs make install for the selected project"
    echo "  uudeploy <proj> -- copies the selected project to MINILOGUE_STUFF_DEPLOY_DIR"
    echo "  uurelease <version> -- creates release package with the version number"
    echo "<proj> parameter can be omitted to use the previously used value"
}

uuhelp
